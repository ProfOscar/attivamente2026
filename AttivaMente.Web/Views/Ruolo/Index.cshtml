@using AttivaMente.Core.Models
@model List<AttivaMente.Core.Models.Ruolo>
<h2>Ruoli disponibili</h2>

<a asp-action="Create" class="btn btn-primary mb-3">Aggiungi</a>

<table class="table table-striped table-bordered">
    <thead><tr><th>ID</th><th>Nome</th><th>Azioni</th></tr></thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.Id</td>
                <td>@r.Nome</td>
                <td>
                    <a asp-action="Edit" asp-route-id="@r.Id" class="btn btn-warning btn-sm">Modifica</a>
                    <a asp-action="Delete" asp-route-id="@r.Id" class="btn btn-danger btn-sm">Elimina</a>
                </td>
            </tr>
        }
    </tbody>
</table>